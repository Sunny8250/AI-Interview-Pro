GEMINI_API_KEY=your_gemini_api_key_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Set to true only behind a reverse proxy that strips inbound x-forwarded-for
# and x-real-ip headers before adding its own trusted values. Vercel is detected
# automatically.
TRUST_PROXY=false

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# OAuth Single Sign-On (SSO) Keys
# Google OAuth setup: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth setup: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# LinkedIn OAuth setup: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Optional Multi-Key Rotation Pools for Fallback AI Providers
# OpenAI Key Pool: Comma-separated OpenAI API keys (https://platform.openai.com/api-keys)
OPENAI_API_KEYS=your_openai_api_key_1,your_openai_api_key_2

# Groq / xAI Grok Key Pool: Comma-separated Groq or Grok API keys (https://console.groq.com/keys)
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_next_public_razorpay_key_id_here
ADMIN_EMAIL=admin@example.com
